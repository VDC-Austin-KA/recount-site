/**
 * Static site for the dictation product, served from Cloudflare's edge.
 *
 * Separate Worker from the ackerworks.com resume site on purpose: deploying the
 * product page must never be able to take down the résumé, and vice versa.
 *
 * Deploy:  npx wrangler deploy
 *
 * Serves recount.ackerworks.com.
 *
 * The custom_domain route makes Cloudflare create the DNS record and
 * certificate automatically, which only works while the ackerworks.com zone is
 * active on the same account. It is.
 */
{
  "name": "recount-site",
  "compatibility_date": "2026-09-15",

  // Only ./docs is uploaded, so notes and configs in this folder can never be served.
  // Named docs/ rather than public/ because GitHub Pages can serve a branch from /docs
  // with no Actions run - which matters while Actions billing is locked.
  "assets": {
    "directory": "./docs",
    "not_found_handling": "404-page"
  },

  // The product takes the apex now; the resume moved to resume.ackerworks.com. Both
  // hostnames are listed so an existing link to either keeps working.
  "routes": [
    { "pattern": "ackerworks.com", "custom_domain": true },
    { "pattern": "www.ackerworks.com", "custom_domain": true },
    { "pattern": "recount.ackerworks.com", "custom_domain": true }
  ],

  // Publishes to *.workers.dev too, so the page can be previewed before the
  // subdomain is pointed at it.
  "workers_dev": true,

  "observability": { "enabled": true }
}
